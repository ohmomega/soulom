# ─── Frontend (build-time, ฝังลงในหน้าเว็บ — ห้ามใส่ความลับ) ─────────────
# ใส่ใน .env.local ตอนรันในเครื่อง และใน Cloudflare Pages > Settings > Environment variables
VITE_KOFI_URL=https://ko-fi.com/your-page
VITE_LEMON_SQUEEZY_URL=https://your-store.lemonsqueezy.com/buy/your-variant-id

# ─── Pages Functions (runtime secrets) ──────────────────────────────────────
# ตอนรันในเครื่องให้ใส่ในไฟล์ .dev.vars (wrangler อ่านไฟล์นี้)
# บน Cloudflare ให้ตั้งเป็น Secret (Encrypt) ใน Pages > Settings > Environment variables
GEMINI_API_KEY=

# จำนวนข้อความฟรีต่อวันต่อ IP (ค่าเริ่มต้น 20)
FREE_DAILY_MESSAGE_LIMIT=20

# ตรวจ License Key ที่ซื้อผ่าน Lemon Squeezy (เว้นว่าง = ปิดการตรวจช่องทางนี้)
LEMON_SQUEEZY_API_KEY=

# บริการตรวจสลิปพร้อมเพย์ (เช่น EasySlip / SlipOK) — เว้นว่าง = ปิดการตรวจสลิป
SLIP_VERIFY_URL=
SLIP_VERIFY_API_KEY=
# ชื่อฟิลด์ไฟล์ที่ผู้ให้บริการต้องการ (EasySlip = file, SlipOK = files)
SLIP_VERIFY_FILE_FIELD=file
# ยอดโอนขั้นต่ำ (บาท) ที่จะออกรหัสให้
SLIP_MIN_AMOUNT_THB=39
# ชื่อบัญชีผู้รับ (บางส่วนก็ได้) เพื่อกันสลิปที่โอนให้คนอื่น — เว้นว่าง = ไม่ตรวจ
SLIP_RECEIVER_NAME=
